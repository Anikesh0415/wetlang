# Git line endings & binary preservation
* text=auto
*.dll binary
*.so binary
*.dylib binary
*.pdf binary
*.wbc binary

# GitHub Linguist Overrides:
# Completely vendor all Python, C, and shell files so they are 100% excluded from repository language stats
*.py linguist-vendored
*.c linguist-vendored
*.h linguist-vendored
*.cmd linguist-vendored
bin/* linguist-vendored
wetlang/** linguist-vendored
native/** linguist-vendored
tests/** linguist-vendored
examples/** linguist-vendored
