# Bytecode & Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# NWB benchmark cache (never commit .nwb files)
.cache/
*.nwb

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & Environment
*.log
.env
.venv
env/
venv/

# C / Native build artifacts
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
native/bin/*.lib
native/bin/*.exp
native/bin/*.def
