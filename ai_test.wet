// Program written directly by AI: Multi-channel sensory burst classifier
organoid Brainlet {
    radius: 175um;
    perfusion: 1.4uL/min;
}

grid mea[8, 8];
channel input_a = mea[1, 1];
channel input_b = mea[1, 2];
channel output_classifier = mea[6, 6];

fn main() {
    // Deliver dual sensory burst
    stim_biphasic(input_a, 0.5V, 0.2ms, 0.2ms);
    sync_tick();
    stim_biphasic(input_b, 0.4V, 0.2ms, 0.2ms);
    sync_tick();

    // Read response spikes
    let count = read_spikes(output_classifier, 20.0ms);
    if (count > 2) {
        // Boost synaptic connection
        modulate_stdp(1.15);
    }
}
